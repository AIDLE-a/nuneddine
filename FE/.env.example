# FE/.env.example — 이 파일을 복사해서 .env로 만든 뒤 실제 키를 채우세요
# cp .env.example .env

# Firebase 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱에서 확인)
VITE_FIREBASE_API_KEY=여기에_Firebase_API_키_입력
VITE_FIREBASE_AUTH_DOMAIN=여기에_Firebase_AUTH_DOMAIN_입력
VITE_FIREBASE_PROJECT_ID=여기에_Firebase_PROJECT_ID_입력
VITE_FIREBASE_STORAGE_BUCKET=여기에_Firebase_STORAGE_BUCKET_입력
VITE_FIREBASE_MESSAGING_SENDER_ID=여기에_Firebase_SENDER_ID_입력
VITE_FIREBASE_APP_ID=여기에_Firebase_APP_ID_입력
